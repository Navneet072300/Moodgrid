# Supabase Connect dialog. Public publishable key only; never a secret/service-role key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Optional legacy fallback, used only when the publishable key is unset.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Exact public app origin, without a trailing slash. Use your Vercel URL in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Journal encryption keys are generated in the browser. No server encryption key or AI API key is used.
